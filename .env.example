# NexTunnel — environment example.
# Copy to `.env` (or set in Railway) and adjust.

# --- Server ---
PORT=8000
# Set by Railway automatically; used to build share links when no request is present.
RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app
# Persistent volume mount (Railway volume or Docker volume).
DATA_DIR=/data

# --- Admin panel ---
# Initial password, written hashed into the DB on first boot.
# The env var is ONLY used once; afterwards change it from the panel.
ADMIN_PASSWORD=NexTunnel@2025

# --- Telegram bot (initial values; afterwards editable from the web panel) ---
TELEGRAM_BOT_TOKEN=
# Comma separated admin chat IDs (numbers only)
TELEGRAM_ADMIN_IDS=

# --- Security ---
# Take the LAST X-Forwarded-For entry as the real client IP.
# Keep this ON behind Railway/Cloudflare. Set to false on a pure direct server.
TRUST_PROXY_HEADERS=true